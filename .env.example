# ---------------------------------------------------------------------------
# Skumetra web — environment variable template
# ---------------------------------------------------------------------------
# The frontend-only MVP needs NONE of these to run. They are listed here so the
# next phase (real lead capture) has a documented contract. Copy this file to
# `.env.local` and fill in values when you wire up a backend.
#
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# Public site URL — used for canonical/OpenGraph metadata.
NEXT_PUBLIC_SITE_URL=https://skumetra.com

# ---------------------------------------------------------------------------
# Pilot application submission (NOT wired up yet).
# When you replace src/lib/services/pilot-submission.ts with a real backend,
# set these. See README → "How to replace simulated form submission".
# ---------------------------------------------------------------------------

# Supabase (one option for lead storage).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Generic form/webhook endpoint (an alternative to Supabase).
# PILOT_SUBMISSION_ENDPOINT=

# Spam protection (e.g. Cloudflare Turnstile) — configure before public launch.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
