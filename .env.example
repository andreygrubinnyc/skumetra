# ---------------------------------------------------------------------------
# Skumetra web — environment variable template
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values for local development
# against a real Supabase project. None of these are required to run
# `npm run dev` / `npm test` / `npm run build` — without Supabase configured,
# the pilot-application route handler uses an in-memory fallback store (not
# durable — see src/lib/services/pilot-application-fallback-store.ts).
#
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# Public site URL — used for canonical/OpenGraph metadata and the sitemap.
# Must be the real production URL in the deployed environment (no localhost).
NEXT_PUBLIC_SITE_URL=https://skumetra.com

# ---------------------------------------------------------------------------
# Supabase — required for real pilot-application storage.
# Run the migration in supabase/migrations/ against your project first.
# ---------------------------------------------------------------------------

# Project URL (Project Settings → API). Safe to expose to the browser, but
# this app currently only uses it server-side (see src/lib/supabase/server-client.ts).
NEXT_PUBLIC_SUPABASE_URL=

# Service-role key (Project Settings → API). SERVER-ONLY — never prefix this
# with NEXT_PUBLIC_, never reference it from a 'use client' file. It bypasses
# Row Level Security; only src/lib/supabase/server-client.ts should read it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Spam protection — next security enhancement, not yet implemented.
# The pilot form currently relies on a honeypot field + basic rate limiting
# (see src/components/pilot/pilot-application-form.tsx and
# src/lib/security/rate-limiter.ts). Add Cloudflare Turnstile here if/when a
# site key is available.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Error monitoring — prepared integration boundary, not yet connected.
# See src/lib/monitoring/error-reporting.ts. Until SENTRY_DSN is set, server
# errors are logged to the console (visible in Vercel function logs) only.
# ---------------------------------------------------------------------------
# SENTRY_DSN=

# ---------------------------------------------------------------------------
# Product analytics — prepared integration boundary, not yet connected.
# See src/lib/monitoring/analytics.ts. Until NEXT_PUBLIC_POSTHOG_KEY is set,
# track() calls are no-ops. Never send form contents or PII as event
# properties — see the boundary file for the approved event list.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
