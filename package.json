{
  "name": "skumetra-web",
  "version": "0.1.0",
  "private": true,
  "description": "Skumetra landing page and Founding Seller Pilot application (frontend-only MVP).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install",
    "prepare": "node scripts/setup-hooks.mjs",
    "security:scan": "node scripts/security/scan-repository.mjs",
    "security:scan:staged": "node scripts/security/scan-staged.mjs",
    "security:public-boundary": "node scripts/security/scan-public-boundary.mjs",
    "security:workflows": "node scripts/security/scan-workflows.mjs",
    "security:all": "npm run security:scan && npm run security:public-boundary && npm run security:workflows",
    "automation:labels": "node scripts/automation/sync-labels.mjs",
    "verify:production": "node scripts/automation/production-smoke.mjs",
    "verify:commit": "npm run security:scan:staged && npm run lint && npm run typecheck && npm test",
    "verify:push": "npm run security:all && npm run lint && npm run typecheck && npm test && npm run build && npm audit --audit-level=high && npm run test:e2e"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@supabase/supabase-js": "^2.112.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
